# लोकल Den — Environment Variables
# Copy this file to .env.local and fill in your values

# ── Supabase ────────────────────────────────────────────────
# Get these from: supabase.com → Your Project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Auth → URL Configuration → add Redirect URLs:
#   http://localhost:5173/reset-password
#   https://YOUR-DOMAIN/reset-password

# ── Razorpay ────────────────────────────────────────────────
# Get this from: razorpay.com → Settings → API Keys
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# ── Instagram Social Agent (Optional) ────────────────────────
# Get from: Meta Developer Portal (developers.facebook.com)
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_meta_graph_api_access_token

