# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# Test coverage files
coverage/
coverage.xml
coverage.json
*.lcov
coverage-*.json
coverage-final.json
.nyc_output/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv


.cursorrules

# Coverage scripts and Docker files
coverage.sh
Dockerfile.coverage
# Environment variables

.env.local
.env.development
.env.production

# Mock services (development only)
src/utils/mockAuthService.js
src/utils/devTokenData.js
src/utils/testAuth.js
src/utils/devTokenData.js

# Environment and configuration files
.env
sonar-project.properties

# Prevent accidental inclusion of other UI projects
pbr_nextgen_ui/
